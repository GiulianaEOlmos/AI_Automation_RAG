# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Qdrant Cloud: the URL of your cluster (ends in :6333) and its API key
# Local Qdrant with Docker: QDRANT_URL=http://localhost:6333 and leave QDRANT_API_KEY empty
QDRANT_URL=
QDRANT_API_KEY=

# LlamaParse API key (only for demo 02, to parse the PDFs): https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=

# Cohere API key (only for demo 04, for re-ranking): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
